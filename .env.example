EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Physical devices need your computer's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3001

# Public, hosted pages required for production builds.
# Ready-to-host pages: public/privacy/ and public/support/ (see docs/SUPPORT_PRIVACY.md).
# Expo Hosting directory URLs must end with a slash: https://YOUR_HOST.expo.app/privacy/
# and https://YOUR_HOST.expo.app/support/ (without it the reader SPA may be served).
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_SUPPORT_URL=
# Set APP_ENV=production for local release config/export validation.
